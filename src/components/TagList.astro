---
interface Props {
  tags?: string[];
}

const { tags = [] } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <li>
          <span class="inline-flex items-center rounded-full bg-surface px-3 py-1.5 text-[13px] font-medium leading-4 text-primary">
            {tag}
          </span>
        </li>
      ))}
    </ul>
  )
}