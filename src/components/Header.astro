---
import ThemeToggle from './ThemeToggle.astro';
import { getNavItems, type NavItem } from '../lib/pages';

const baseLinks: NavItem[] = [
  { href: '/', label: 'Inicio', order: 0 },
  { href: '/blog/', label: 'Blog', order: 1 },
];
const pageLinks = await getNavItems();
const links = [...baseLinks, ...pageLinks].sort((a, b) => a.order - b.order);

const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---

<header class="border-b border-line">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-5">
    <a href="/" class="font-display text-lg font-bold text-primary">BibleFly</a>
    <nav class="flex items-center gap-6">
      <ul class="flex items-center gap-6">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'text-[15px] font-semibold',
                  isActive(link.href)
                    ? 'text-primary'
                    : 'text-secondary hover:text-primary',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
    </nav>
  </div>
</header>