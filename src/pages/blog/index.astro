---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getAllPosts } from '../../lib/posts';

const posts = await getAllPosts();
---

<Layout
  title="Blog"
  description="Todas las lecturas bíblicas, devocionales y reflexiones de BibleFly."
>
  <section class="mx-auto max-w-5xl px-6 pt-12 pb-12 sm:pt-16 sm:pb-16">
    <header class="mb-10">
      <h1
        class="font-display text-[28px] leading-[34px] font-bold text-primary sm:text-[32px] sm:leading-[38px]"
      >
        Blog
      </h1>
      <p class="mt-3 text-[16px] leading-[24px] text-secondary">
        Todas las publicaciones de BibleFly, ordenadas por fecha.
      </p>
    </header>

    {
      posts.length === 0 ? (
        <p class="text-secondary">
          Todavía no hay publicaciones. Vuelve pronto.
        </p>
      ) : (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      )
    }
  </section>
</Layout>