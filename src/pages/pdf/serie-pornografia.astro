---
import { getCollection, render } from 'astro:content';

const slugs = [
  'pornografia-1-enemigo-silencioso',
  'pornografia-2-lo-que-la-biblia-dice',
  'pornografia-3-fuerza-de-voluntad',
  'pornografia-4-camino-a-la-libertad',
  'pornografia-5-gracia-que-restaura',
];

const posts = await getCollection('blog');
const serie = slugs
  .map((slug) => posts.find((p) => p.id === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

const articulos = await Promise.all(
  serie.map(async (post) => {
    const { Content } = await render(post);
    return { data: post.data, Content };
  })
);
