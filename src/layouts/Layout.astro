---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
</head>
<body>
  <header>
    <a href="/">BibleFly Blog</a>
  </header>
  <main>
    <slot />
  </main>
  <footer>
    <p>© 2026 BibleFly</p>
  </footer>
</body>
</html>